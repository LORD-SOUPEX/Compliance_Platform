{
  "version": "1",
  "id": "python.quality",
  "name": "Python Quality Pipeline",
  "technology": "python",
  "category": "quality",
  "side_effect_level": "read_only",
  "steps": [
    {
      "id": "format",
      "name": "Ruff Format Check",
      "tool": "ruff",
      "args": [
        "format",
        "--check",
        "--no-cache"
      ],
      "side_effect": "read_only",
      "timeout_seconds": 60
    },
    {
      "id": "lint",
      "name": "Ruff Linting",
      "tool": "ruff",
      "args": [
        "check",
        "--no-cache"
      ],
      "side_effect": "read_only",
      "depends_on": [
        "format"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "security",
      "name": "Bandit Security Audit",
      "tool": "bandit",
      "args": [
        "-q",
        "-r",
        "."
      ],
      "side_effect": "read_only",
      "depends_on": [
        "lint"
      ],
      "timeout_seconds": 180
    }
  ]
}
