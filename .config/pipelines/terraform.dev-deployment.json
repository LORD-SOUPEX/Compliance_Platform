{
  "version": "1",
  "id": "terraform.dev-deployment",
  "name": "Terraform Dev Deployment",
  "technology": "terraform",
  "category": "dev_deployment",
  "side_effect_level": "apply_destroy",
  "guardrails": {
    "allowed_environments": [
      "sandbox",
      "dev-local",
      "ephemeral-*"
    ],
    "forbidden_environments": [
      "prod",
      "production",
      "staging",
      "shared"
    ],
    "require_plan_preview": true,
    "require_explicit_confirmation": true,
    "state_backend_restrictions": [
      "local",
      "dev-*"
    ]
  },
  "steps": [
    {
      "id": "init",
      "name": "Terraform / OpenTofu Init",
      "tool": "tofu",
      "args": [
        "init",
        "-input=false"
      ],
      "side_effect": "network",
      "timeout_seconds": 180
    },
    {
      "id": "plan",
      "name": "Terraform / OpenTofu Plan Preview",
      "tool": "tofu",
      "args": [
        "plan",
        "-input=false",
        "-out=tfplan"
      ],
      "side_effect": "read_only",
      "depends_on": [
        "init"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "apply",
      "name": "Terraform / OpenTofu Apply Local Dev",
      "tool": "tofu",
      "args": [
        "apply",
        "-input=false",
        "tfplan"
      ],
      "side_effect": "apply_destroy",
      "depends_on": [
        "plan"
      ],
      "timeout_seconds": 600
    }
  ]
}
