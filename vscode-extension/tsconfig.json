{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "moduleDetection": "legacy",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".extension-build",
    "paths": { "@vscode/test-electron": ["./node_modules/@vscode/test-electron"] },
    "typeRoots": ["./node_modules/@types"],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "media/**/*.ts"]
}
